# Copy to .env (git-ignored) and fill in. Never commit real keys.

# --- Market profile -----------------------------------------------------------
TRADINGAGENTS_MARKET=IN

# --- Upstox: broker + live market data ---------------------------------------
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3000/api/oauth/callback
# Long-lived read-only market-data token (Upstox "Analytics"/Extended token):
UPSTOX_ANALYTICS_TOKEN=
# Daily session token. Expires every day ~03:30 IST. Leave empty and use the
# "Connect Upstox" button in the terminal to refresh it via OAuth instead.
UPSTOX_ACCESS_TOKEN=

# --- LLM for the 12 agents (any OpenAI-compatible endpoint) -------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_MODEL=high-availability
TRADINGAGENTS_LLM_PROVIDER=openai
TRADINGAGENTS_LLM_BACKEND_URL=http://localhost:20128/v1
TRADINGAGENTS_DEEP_THINK_LLM=high-availability
TRADINGAGENTS_QUICK_THINK_LLM=high-availability

# --- Terminal -----------------------------------------------------------------
TERMINAL_HOST=127.0.0.1
TERMINAL_PORT=3000
PAPER_INITIAL_BALANCE=1000000
# TERMINAL_MOCK=1                      # offline UI development with fictional prices

# --- NSE calendar overrides (optional) ---------------------------------------
# NSE_HOLIDAYS_FILE=/path/to/holidays.json          # {"2027-01-26": "Republic Day", ...}
# NSE_SPECIAL_SESSIONS=2026-11-08=18:15-19:15       # muhurat / special session, per the NSE circular
